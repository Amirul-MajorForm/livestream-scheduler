# Postgres connection string (Railway sets this when you add a Postgres service and reference it)
DATABASE_URL=postgres://postgres@localhost:5432/scheduler
# Long random string used to sign login sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=
# First admin account, created on first start if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: enables reading pasted availability messages with Claude
ANTHROPIC_API_KEY=
